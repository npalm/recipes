{
  "name": "@recipes/cli",
  "version": "0.1.0",
  "description": "CLI tool for creating and importing recipes using AI",
  "type": "module",
  "bin": {
    "recipe": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^14.0.3",
    "dotenv": "^18.0.9",
    "gray-matter": "^4.0.3",
    "node-fetch": "^3.3.2",
    "ora": "^9.4.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "24.x",
    "pnpm": ">=11 <12"
  }
}
