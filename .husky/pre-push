#!/usr/bin/env sh

echo "🔍 Running pre-push checks..."
echo ""

# Type check
echo "📝 Type checking..."
corepack pnpm typecheck
if [ $? -ne 0 ]; then
  echo "❌ Type check failed! Fix type errors before pushing."
  exit 1
fi
echo "✅ Type check passed"
echo ""

# Run tests
echo "🧪 Running tests..."
corepack pnpm exec vitest run
if [ $? -ne 0 ]; then
  echo "❌ Tests failed! Fix failing tests before pushing."
  exit 1
fi
echo "✅ Tests passed"
echo ""

# Check the standalone local editor
echo "🖼️  Checking image editor..."
corepack pnpm images:lint && corepack pnpm images:test
if [ $? -ne 0 ]; then
  echo "❌ Image editor checks failed!"
  exit 1
fi
echo "✅ Image editor checks passed"
echo ""

# Build check
echo "🔨 Running build check..."
corepack pnpm build
if [ $? -ne 0 ]; then
  echo "❌ Build failed! Fix the build before pushing."
  exit 1
fi
echo "✅ Build passed"
echo ""

echo "✅ All pre-push checks passed! Pushing..."
